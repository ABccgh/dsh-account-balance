    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "author": "ABccgh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABccgh/dsh-account-balance.git"
